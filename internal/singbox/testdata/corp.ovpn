# Тестовый конфиг: ключи сгенерированы только для тестов
client
dev tun
proto udp
remote vpn.example.com 1194
remote 203.0.113.10 443 tcp
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name "vpn server" name
cipher AES-256-CBC
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
key-direction 1
auth-user-pass
redirect-gateway def1
keepalive 10 60
verb 3
