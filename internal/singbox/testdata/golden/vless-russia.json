{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain_suffix": [
          "ru",
          "su",
          "xn--p1ai"
        ],
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite-category-ru"
        ],
        "server": "dns-direct"
      }
    ],
    "servers": [
      {
        "server": "77.88.8.8",
        "tag": "dns-direct",
        "type": "udp"
      },
      {
        "detour": "proxy",
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "type": "https"
      }
    ],
    "strategy": "ipv4_only"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    }
  },
  "http_clients": [
    {
      "tag": "rule-sets"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "interface_name": "vpn-client",
      "mtu": 9000,
      "stack": "mixed",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "server": "vless.example.com",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "jNXHt1yRo0vDuchQlIP6Z0ZvjT3KtzVI-T4E7RoLJS0",
          "short_id": "0123456789abcdef"
        },
        "server_name": "www.microsoft.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "11111111-2222-3333-4444-555555555555"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "default_http_client": "rule-sets",
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "tag": "geosite-category-ru",
        "type": "remote",
        "update_interval": "72h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ru.srs"
      },
      {
        "format": "binary",
        "tag": "geoip-ru",
        "type": "remote",
        "update_interval": "72h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "ru",
          "su",
          "xn--p1ai"
        ],
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-category-ru",
          "geoip-ru"
        ]
      }
    ]
  }
}