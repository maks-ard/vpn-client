        }
      },
      "type": "vless",
      "uuid": "11111111-2222-3333-4444-555555555555"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "default_http_client": "rule-sets",
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "tag": "geosite-category-ru",
        "type": "remote",
        "update_interval": "72h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ru.srs"
      },
      {
        "format": "binary",
        "tag": "geoip-ru",
        "type": "remote",
        "update_interval": "72h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "domain_suffix": [
          "corp.example.com",
          "office.example"
        ],
        "outbound": "corp"
      },
      {
        "outbound": "corp",
        "preferred_by": [
          "corp"
        ]
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "ru",
          "su",
          "xn--p1ai"
        ],
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-category-ru",
          "geoip-ru"
        ]
      }
    ]
  }
